    {
      "type": "nunu/animation/playback",
      "title": "Animation Playback",
      "description": "Control an object's animation clips while running: play, pause, toggle, stop (rewinds), restart, or set speed (negative plays backwards). With a clip name, play and restart run only that clip and speed applies only to it.",
      "since": 1,
      "category": "Animation",
      "accepts": "Animated",
      "effect": "write",
      "inputs": [
        {
          "name": "apply",
          "type": -1
        },
        {
          "name": "object",
          "type": "nunu_object,object"
        },
        {
          "name": "speed",
          "type": "number"
        }
      ],
      "outputs": [
        {
          "name": "done",
          "type": -1
        },
        {
          "name": "failed",
          "type": -1
        },
        {
          "name": "success",
          "type": "boolean"
        },
        {
          "name": "message",
          "type": "string"
        },
        {
          "name": "playing",
          "type": "boolean"
        },
        {
          "name": "time",
          "type": "number"
        }
      ],
      "properties": {
        "operation": "toggle",
        "clip": "",
        "speed": 1
      }
    },
    {
      "type": "nunu/audio/playback",
