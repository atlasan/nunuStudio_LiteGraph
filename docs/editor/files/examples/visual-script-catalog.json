    {
      "type": "nunu/objects/spawn_copy",
      "title": "Spawn Copy",
      "description": "Copy an authored object (meshes, groups, lights) into this running script. The copy keeps the source's world rotation and scale, is placed at a world offset from it (stacked per live copy), shares its geometry and materials, and is removed on stop. Objects with scripts, physics, audio or cameras are rejected.",
      "since": 1,
      "category": "Lifecycle",
      "accepts": "Object3D",
      "effect": "write",
      "inputs": [
        {
          "name": "apply",
          "type": -1
