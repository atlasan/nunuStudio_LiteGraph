    },
    {
      "type": "nunu/materials/color",
      "title": "Mesh Color",
      "description": "Tint a mesh's color-capable materials. By default clone once per object; opt in to modifying shared materials.",
      "since": 1,
      "category": "Material",
      "accepts": "Mesh",
