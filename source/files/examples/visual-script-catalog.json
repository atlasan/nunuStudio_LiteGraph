{
  "version": 1,
  "nodes": [
    {
      "type": "nunu/camera/projection",
      "title": "Camera Projection",
      "description": "Set perspective FOV (degrees) and clipping planes. Orthographic cameras accept clipping only; projection matrices update atomically.",
      "since": 1,
      "category": "Camera",
      "accepts": "Camera",
      "effect": "write",
      "inputs": [
        {
          "name": "apply",
          "type": -1
        },
        {
          "name": "object",
          "type": "nunu_object,object"
        },
        {
          "name": "fov",
          "type": "number"
        },
        {
          "name": "near",
          "type": "number"
        },
        {
          "name": "far",
          "type": "number"
        }
      ],
      "outputs": [
        {
          "name": "done",
          "type": -1
        },
        {
          "name": "failed",
          "type": -1
        },
        {
          "name": "success",
          "type": "boolean"
        },
        {
          "name": "message",
          "type": "string"
        }
      ],
      "properties": {
        "fov": 50,
        "near": 0.1,
        "far": 100
      }
    },
    {
      "type": "nunu/data/get",
      "title": "Get Object Data",
      "description": "Read an own userData field without invoking inherited properties; fallback defaults to zero.",
      "since": 1,
      "category": "Data",
      "accepts": "Object3D",
      "effect": "read",
      "inputs": [
        {
          "name": "object",
          "type": "nunu_object,object"
        }
      ],
      "outputs": [
        {
          "name": "value",
          "type": 0
        },
        {
          "name": "found",
          "type": "boolean"
        }
      ],
      "properties": {
        "key": "health",
        "fallback": 0
      }
    },
    {
      "type": "nunu/data/set",
      "title": "Set Object Data",
      "description": "Set a userData field to a JSON scalar (finite number, string, boolean or null). This is not arbitrary object-property reflection.",
      "since": 1,
      "category": "Data",
      "accepts": "Object3D",
      "effect": "write",
      "inputs": [
        {
          "name": "apply",
          "type": -1
        },
        {
          "name": "object",
          "type": "nunu_object,object"
        },
        {
          "name": "value",
          "type": 0
        }
      ],
      "outputs": [
        {
          "name": "done",
          "type": -1
        },
        {
          "name": "failed",
          "type": -1
        },
        {
          "name": "success",
          "type": "boolean"
        },
        {
          "name": "message",
          "type": "string"
        }
      ],
      "properties": {
        "key": "health",
        "value": 100
      }
    },
    {
      "type": "nunu/keyboard",
      "title": "Keyboard",
      "description": "Read nunuStudio's frame-synchronized input. 32 = Space, 65 = A, 87 = W.",
      "since": 1,
      "category": "Input",
      "accepts": "Program",
      "effect": "read",
      "inputs": [],
      "outputs": [
        {
          "name": "down",
          "type": "boolean"
        },
        {
          "name": "pressed",
          "type": -1
        },
        {
          "name": "released",
          "type": -1
        }
      ],
      "properties": {
        "key": 32
      }
    },
    {
      "type": "nunu/mouse",
      "title": "Mouse",
