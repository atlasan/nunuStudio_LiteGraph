          "name": "down",
          "type": "boolean"
        },
        {
          "name": "pressed",
          "type": -1
        },
        {
          "name": "released",
          "type": -1
        }
      ],
      "properties": {
        "button": 0
      }
    },
    {
      "type": "nunu/events",
      "title": "Scene Events",
