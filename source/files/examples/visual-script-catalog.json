    {
      "type": "nunu/objects/find",
      "title": "Find Object",
      "description": "Find exact names under a root (default: current scene). First match and all matches; UUID bindings are more stable.",
      "since": 1,
      "category": "Scene",
      "accepts": "Object3D",
      "effect": "read",
      "inputs": [
        {
          "name": "root",
          "type": "nunu_object,object"
        }
      ],
      "outputs": [
        {
          "name": "object",
          "type": "nunu_object"
        },
        {
          "name": "found",
          "type": "boolean"
        },
        {
          "name": "matches",
          "type": "array"
        }
      ],
      "properties": {
        "name": "Spinning box"
      }
    },
    {
      "type": "nunu/object",
      "title": "Nunu Object",
      "description": "Reference a scene object by UUID; use selected in the editor to bind it.",
      "since": 1,
      "category": "Scene",
      "accepts": "Object3D",
      "effect": "read",
      "inputs": [],
      "outputs": [
        {
          "name": "object",
          "type": "nunu_object"
