          "name": "delta",
          "type": "number"
        },
        {
          "name": "time",
          "type": "number"
        },
        {
          "name": "size",
          "type": "vec2"
        },
        {
          "name": "data",
          "type": 0
        }
      ],
      "properties": {}
    },
    {
      "type": "nunu/lights/settings",
      "title": "Light Settings",
      "description": "Set a light's finite non-negative intensity and color (#RRGGBB or normalized RGB). Does not alter shadow configuration.",
      "since": 1,
      "category": "Light",
      "accepts": "Light",
      "effect": "write",
      "inputs": [
