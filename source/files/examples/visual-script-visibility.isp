      "checkShaderErrors": true,
      "gammaFactor": 2,
      "precision": "highp",
      "alpha": true,
      "premultipliedAlpha": true,
      "preserveDrawingBuffer": false,
      "powerPreference": "high-performance",
      "logarithmicDepthBuffer": false,
      "physicallyCorrectLights": false,
      "maxMorphTargets": 8,
      "maxMorphNormals": 4
    }
  }
}
